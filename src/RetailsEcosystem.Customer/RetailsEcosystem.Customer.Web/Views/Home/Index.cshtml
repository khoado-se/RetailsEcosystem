@using RetailsEcosystem.Customer.Shared
@{
    ViewData["Title"] = "Home Page";
    var featureProducts = ViewBag.FeatureProducts as List<ProductDto>;
}

<!-- ══ Hero Area ══════════════════════════════════════════════════════ -->
<section class="hero-area">
    <div class="container">
        <div class="row">

            <!-- Main slider: products 0 + 1 -->
            <div class="col-lg-8 col-12 custom-padding-right">
                <div class="slider-head">
                    <div class="hero-slider">

                        @for (int i = 0; i < Math.Min(2, featureProducts?.Count ?? 0); i++)
                        {
                            var sp = featureProducts![i];
                            var desc = sp.Description?.Length > 100
                                ? sp.Description[..100] + "…"
                                : sp.Description ?? string.Empty;
                            var url  = Url.Action("ProductDetails", "Products", new { productId = sp.Id }) ?? "#";
                            var bg   = i == 0 ? "#f0f5fb" : "#f5f0fb";

                            var vm = new PromoBannerViewModel
                            {
                                Category      = sp.Category?.Name,
                                Title         = sp.Name,
                                Subtitle      = desc,
                                Price         = sp.Price,
                                ImageUrl      = sp.ImageUrl,
                                BgColor       = bg,
                                ButtonUrl     = url,
                                ButtonText    = "Shop Now",
                            };

                            <div class="single-slider">
                                <partial name="_PromoBanner" model="vm" />
                            </div>
                        }

                    </div>
                </div>
            </div>

            <!-- Right column: product 2 + weekly sale -->
            <div class="col-lg-4 col-12">
                <div class="row g-3 h-100">

                    @if (featureProducts?.Count > 2)
                    {
                        var sb    = featureProducts[2];
                        var sbUrl = Url.Action("ProductDetails", "Products", new { productId = sb.Id }) ?? "#";
                        var sbVm  = new PromoBannerViewModel
                        {
                            Category        = sb.Category?.Name,
                            Title           = sb.Name,
                            Price           = sb.Price,
                            ImageUrl        = sb.ImageUrl,
                            BgColor         = "#fff8f0",
                            ButtonUrl       = sbUrl,
                            ButtonText      = "View Details",
                            AdditionalClass = "promo-banner--compact",
                        };
                        <div class="col-lg-12 col-md-6 col-12">
                            <partial name="_PromoBanner" model="sbVm" />
                        </div>
                    }

                    <div class="col-lg-12 col-md-6 col-12">
                        <div class="weekly-sale-card">
                            <h3>Weekly Sale!</h3>
                            <p>Saving up to 50% off all items.</p>
                            <a asp-controller="Products" asp-action="ProductIndex" class="promo-cta">Shop Now</a>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
<!-- ══ End Hero Area ══════════════════════════════════════════════════ -->

<!-- ══ Campaign Banners ══════════════════════════════════════════════ -->
@if (featureProducts?.Count > 3)
{
    <section class="campaign-banners-section">
        <div class="container">
            <div class="row g-4">

                @{
                    var pb1     = featureProducts[3];
                    var pb1Url  = Url.Action("ProductDetails", "Products", new { productId = pb1.Id }) ?? "#";
                    var pb1Desc = pb1.Description?.Length > 90
                        ? pb1.Description[..90] + "…"
                        : pb1.Description ?? string.Empty;

                    var pb1Vm = new PromoBannerViewModel
                    {
                        Category   = pb1.Category?.Name,
                        Title      = pb1.Name,
                        Subtitle   = pb1Desc,
                        Price      = pb1.Price,
                        ImageUrl   = pb1.ImageUrl,
                        BgColor    = "#f0f5fb",
                        ButtonUrl  = pb1Url,
                        ButtonText = "View Details",
                    };
                }
                <div class="col-lg-6 col-12">
                    <partial name="_PromoBanner" model="pb1Vm" />
                </div>

                @if (featureProducts.Count > 4)
                {
                    var pb2     = featureProducts[4];
                    var pb2Url  = Url.Action("ProductDetails", "Products", new { productId = pb2.Id }) ?? "#";
                    var pb2Desc = pb2.Description?.Length > 90
                        ? pb2.Description[..90] + "…"
                        : pb2.Description ?? string.Empty;

                    var pb2Vm = new PromoBannerViewModel
                    {
                        Category       = pb2.Category?.Name,
                        Title          = pb2.Name,
                        Subtitle       = pb2Desc,
                        Price          = pb2.Price,
                        ImageUrl       = pb2.ImageUrl,
                        BgColor        = "#fff8f0",
                        ButtonUrl      = pb2Url,
                        ButtonText     = "Shop Now",
                        ReverseLayout  = true,
                    };
                    <div class="col-lg-6 col-12">
                        <partial name="_PromoBanner" model="pb2Vm" />
                    </div>
                }

            </div>
        </div>
    </section>
}
<!-- ══ End Campaign Banners ══════════════════════════════════════════ -->

<!-- ══ Best Sellers ══════════════════════════════════════════════════ -->
@if (featureProducts != null && featureProducts.Count > 0)
{
    <section class="best-sellers-section">
        <div class="container">
            <div class="best-sellers-header mb-4">
                <div>
                    <h2 class="best-sellers-title">Best Sellers</h2>
                    <p class="best-sellers-subtitle">Our most popular products, loved by customers</p>
                </div>
                <a asp-controller="Products" asp-action="ProductIndex">
                    <span class="custom-badge text-uppercase">See More</span>
                </a>
            </div>

            <div class="row g-3">
                @foreach (var product in featureProducts)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                        <div class="best-seller-card">
                            <div class="card-img-wrapper">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top">
                                }
                                else
                                {
                                    <div class="card-img-placeholder">
                                        <i class="lni lni-image"></i>
                                    </div>
                                }
                                <span class="badge-best-seller">Best Seller</span>
                                @if (product.StockQuantity > 0)
                                {
                                    <span class="badge-stock in-stock">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge-stock out-of-stock">Out of Stock</span>
                                }
                                <button class="btn-cart-icon"
                                        data-action="add-to-cart"
                                        data-product-id="@product.Id"
                                        title="Add to Cart"
                                        @(product.StockQuantity == 0 ? "disabled" : "")>
                                    <i class="lni lni-cart"></i>
                                </button>
                            </div>
                            <div class="card-body">
                                <p class="card-category">@product.Category?.Name</p>
                                <a asp-controller="Products" asp-action="ProductDetails" asp-route-productId="@product.Id"
                                   class="card-product-name">@product.Name</a>
                                <p class="card-price">@product.Price.ToString("N0") ₫</p>
                                <button class="btn btn-add-cart"
                                        data-action="add-to-cart"
                                        data-product-id="@product.Id"
                                        @(product.StockQuantity == 0 ? "disabled" : "")>
                                    @(product.StockQuantity == 0 ? "Out of Stock" : "Add to Cart")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}
<!-- ══ End Best Sellers ═══════════════════════════════════════════════ -->

@section Styles {
    <link href="~/css/home/promo-banner.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/home/featuredProducts.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}

@using RetailsEcosystem.Customer.Shared
@{
    ViewData["Title"] = "Home Page";

    // Hero images
    var sliderBg1 = Url.Content("~/images/hero/slider-bg1.jpg");
    var sliderBg2 = Url.Content("~/images/hero/slider-bg2.jpg");
    var smallBanner = Url.Content("~/images/hero/slider-bnr.jpg");

    // Banner images
    var banner1 = Url.Content("~/images/banner/banner-1-bg.jpg");
    var banner2 = Url.Content("~/images/banner/banner-2-bg.jpg");

    var featureProducts = ViewBag.FeatureProducts as List<ProductDto>;
}

<!-- Start Hero Area -->
<section class="hero-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-12 custom-padding-right">
                <div class="slider-head">
                    <div class="hero-slider">

                        <div class="single-slider" style="background-image: url('@sliderBg1');">
                            <div class="content">
                                <h2>
                                    <span>No restocking fee ($35 savings)</span>
                                    M75 Sport Watch
                                </h2>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                                </p>
                                <h3><span>Now Only</span> $320.99</h3>
                                <div class="button">
                                    <a href="#" class="btn">Shop Now</a>
                                </div>
                            </div>
                        </div>

                        <div class="single-slider" style="background-image: url('@sliderBg2');">
                            <div class="content">
                                <h2>
                                    <span>Big Sale Offer</span>
                                    Get the Best Deal on CCTV Camera
                                </h2>
                                <p>
                                    Lorem ipsum dolor sit amet, consectetur adipiscing elit.
                                </p>
                                <h3><span>Combo Only:</span> $590.00</h3>
                                <div class="button">
                                    <a href="#" class="btn">Shop Now</a>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-12">
                <div class="row">
                    <div class="col-lg-12 col-md-6 col-12 md-custom-padding">

                        <div class="hero-small-banner" style="background-image: url('@smallBanner');">
                            <div class="content">
                                <h2>
                                    <span>New line required</span>
                                    iPhone 12 Pro Max
                                </h2>
                                <h3>$259.99</h3>
                            </div>
                        </div>

                    </div>

                    <div class="col-lg-12 col-md-6 col-12">
                        <div class="hero-small-banner style2">
                            <div class="content">
                                <h2>Weekly Sale!</h2>
                                <p>Saving up to 50% off all items.</p>
                                <div class="button">
                                    <a class="btn" href="#">Shop Now</a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
<!-- End Hero Area -->
<!-- Start Banner Area -->
<section class="banner section">
    <div class="container">
        <div class="row">

            <div class="col-lg-6 col-md-6 col-12">
                <div class="single-banner" style="background-image:url('@banner1')">
                    <div class="content">
                        <h2>Smart Watch 2.0</h2>
                        <p>Space Gray Aluminum Case with <br>Black Sport Band</p>
                        <div class="button">
                            <a href="#" class="btn">View Details</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6 col-12">
                <div class="single-banner custom-responsive-margin"
                     style="background-image:url('@banner2')">
                    <div class="content">
                        <h2>Smart Headphone</h2>
                        <p>Lorem ipsum dolor sit amet.</p>
                        <div class="button">
                            <a href="#" class="btn">Shop Now</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>
<!-- End Banner Area -->
@if (featureProducts != null)
{
    @* Featured Product  *@
    <div class="container mt-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>Featured Product</h2>
            <a asp-controller="Products" asp-action="ProductIndex">
                <span class="custom-badge text-uppercase">See More</span>
            </a>
        </div>

        <div class="row">
            @foreach (var product in featureProducts)
            {
                <div class="col-md-3">
                    <a class="card" asp-controller="Products" asp-action="ProductDetails" asp-route-productId="@product.Id">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex flex-row align-items-center time">
                                <i class="fa fa-clock-o"></i>
                                <small class="ml-1">3 Days</small>
                            </div>

                            <img src="https://i.imgur.com/suuFVrQ.png" width="20">
                        </div>

                        <div class="text-center">
                            <img src="https://i.imgur.com/TbtwkyW.jpg" width="250">
                        </div>

                        <div class="text-center">
                            <h5>@product.Name</h5>
                            <span class="text-success">@product.Price.ToString("C")</span>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
}

@section Styles {
    <link href="~/css/home/featuredProducts.css" rel="stylesheet" />
}

@using RetailsEcosystem.Customer.Shared
@{
    ViewData["Title"] = "Home Page";

    // Hero images
    var sliderBg1 = Url.Content("~/images/hero/slider-bg1.jpg");
    var sliderBg2 = Url.Content("~/images/hero/slider-bg2.jpg");
    var smallBanner = Url.Content("~/images/hero/slider-bnr.jpg");

    // Banner images
    var banner1 = Url.Content("~/images/banner/banner-1-bg.jpg");
    var banner2 = Url.Content("~/images/banner/banner-2-bg.jpg");

    var featureProducts = ViewBag.FeatureProducts as List<ProductDto>;
}

<!-- Start Hero Area -->
<section class="hero-area">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 col-12 custom-padding-right">
                <div class="slider-head">
                    <div class="hero-slider">

                        @for (int i = 0; i < Math.Min(2, featureProducts?.Count ?? 0); i++)
                        {
                            var sp = featureProducts![i];
                            var bg = i == 0 ? sliderBg1 : sliderBg2;
                            var shortDesc = sp.Description?.Length > 80
                                ? sp.Description[..80] + "…"
                                : sp.Description ?? string.Empty;
                            <div class="single-slider" style="background-image: url('@bg');">
                                <div class="content">
                                    <h2>
                                        <span>@sp.Category?.Name</span>
                                        @sp.Name
                                    </h2>
                                    <p>@shortDesc</p>
                                    <h3><span>Only</span> @sp.Price.ToString("N0") ₫</h3>
                                    <div class="button">
                                        <a asp-controller="Products" asp-action="ProductDetails"
                                           asp-route-productId="@sp.Id" class="btn">Shop Now</a>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-12">
                <div class="row">
                    <div class="col-lg-12 col-md-6 col-12 md-custom-padding">

                        @if (featureProducts?.Count > 2)
                        {
                            var sb = featureProducts[2];
                            <div class="hero-small-banner" style="background-image: url('@smallBanner');">
                                <div class="content">
                                    <h2>
                                        <span>@sb.Category?.Name</span>
                                        @sb.Name
                                    </h2>
                                    <h3>@sb.Price.ToString("N0") ₫</h3>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="hero-small-banner" style="background-image: url('@smallBanner');"></div>
                        }

                    </div>

                    <div class="col-lg-12 col-md-6 col-12">
                        <div class="hero-small-banner style2">
                            <div class="content">
                                <h2>Weekly Sale!</h2>
                                <p>Saving up to 50% off all items.</p>
                                <div class="button">
                                    <a class="btn" asp-controller="Products" asp-action="ProductIndex">Shop Now</a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>
<!-- End Hero Area -->
<!-- Start Banner Area -->
@if (featureProducts?.Count > 3)
{
    <section class="banner section">
        <div class="container">
            <div class="row">

                @{
                    var pb1 = featureProducts[3];
                    var pb1Desc = pb1.Description?.Length > 60
                        ? pb1.Description[..60] + "…"
                        : pb1.Description ?? string.Empty;
                }
                <div class="col-lg-6 col-md-6 col-12">
                    <div class="single-banner" style="background-image:url('@banner1')">
                        <div class="content">
                            <h2>@pb1.Name</h2>
                            <p>@pb1Desc</p>
                            <div class="button">
                                <a asp-controller="Products" asp-action="ProductDetails"
                                   asp-route-productId="@pb1.Id" class="btn">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>

                @if (featureProducts.Count > 4)
                {
                    var pb2 = featureProducts[4];
                    var pb2Desc = pb2.Description?.Length > 60
                        ? pb2.Description[..60] + "…"
                        : pb2.Description ?? string.Empty;
                    <div class="col-lg-6 col-md-6 col-12">
                        <div class="single-banner custom-responsive-margin"
                             style="background-image:url('@banner2')">
                            <div class="content">
                                <h2>@pb2.Name</h2>
                                <p>@pb2Desc</p>
                                <div class="button">
                                    <a asp-controller="Products" asp-action="ProductDetails"
                                       asp-route-productId="@pb2.Id" class="btn">Shop Now</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </section>
}
<!-- End Banner Area -->
@if (featureProducts != null && featureProducts.Count > 0)
{
    <section class="best-sellers-section">
        <div class="container">
            <div class="best-sellers-header mb-4">
                <div>
                    <h2 class="best-sellers-title">Best Sellers</h2>
                    <p class="best-sellers-subtitle">Our most popular products, loved by customers</p>
                </div>
                <a asp-controller="Products" asp-action="ProductIndex">
                    <span class="custom-badge text-uppercase">See More</span>
                </a>
            </div>

            <div class="row g-3">
                @foreach (var product in featureProducts)
                {
                    <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                        <div class="best-seller-card">
                            <div class="card-img-wrapper">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" class="card-img-top">
                                }
                                else
                                {
                                    <div class="card-img-placeholder">
                                        <i class="lni lni-image"></i>
                                    </div>
                                }
                                <span class="badge-best-seller">Best Seller</span>
                                @if (product.StockQuantity > 0)
                                {
                                    <span class="badge-stock in-stock">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge-stock out-of-stock">Out of Stock</span>
                                }
                                <button class="btn-cart-icon"
                                        data-action="add-to-cart"
                                        data-product-id="@product.Id"
                                        title="Add to Cart"
                                        @(product.StockQuantity == 0 ? "disabled" : "")>
                                    <i class="lni lni-cart"></i>
                                </button>
                            </div>
                            <div class="card-body">
                                <p class="card-category">@product.Category?.Name</p>
                                <a asp-controller="Products" asp-action="ProductDetails" asp-route-productId="@product.Id"
                                   class="card-product-name">@product.Name</a>
                                <p class="card-price">@product.Price.ToString("N0") ₫</p>
                                <button class="btn btn-add-cart"
                                        data-action="add-to-cart"
                                        data-product-id="@product.Id"
                                        @(product.StockQuantity == 0 ? "disabled" : "")>
                                    @(product.StockQuantity == 0 ? "Out of Stock" : "Add to Cart")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

@section Styles {
    <link href="~/css/home/featuredProducts.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}

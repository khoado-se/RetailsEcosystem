@model RetailsEcosystem.Customer.Web.Models.Vnpay.VnpayReturnViewModel
@{
    ViewData["Title"] = Model.Success ? "Payment Successful" : (Model.Cancelled ? "Payment Cancelled" : "Payment Failed");
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Start Breadcrumbs -->
<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">@ViewData["Title"]</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a asp-controller="Home" asp-action="Index"><i class="lni lni-home"></i> Home</a></li>
                    <li>VNPay</li>
                    <li>@ViewData["Title"]</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumbs -->

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">

                @if (Model.Success)
                {
                    <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 text-center">
                        <i class="lni lni-checkmark-circle fs-1 d-block mb-3"></i>
                        <h4 class="fw-bold mb-2">Payment Successful</h4>
                        <p class="mb-1">Order <strong>#@Model.OrderId</strong> has been confirmed.</p>
                        <p class="mb-3">Amount paid: <strong>@Model.Amount.ToString("C0")</strong></p>
                        <div class="d-flex gap-2 justify-content-center flex-wrap">
                            <a asp-controller="Order" asp-action="Detail" asp-route-id="@Model.OrderId"
                               class="btn btn-success rounded-pill px-4">
                                <i class="lni lni-eye me-2"></i>View Order
                            </a>
                            <a asp-controller="Home" asp-action="Index"
                               class="btn btn-outline-success rounded-pill px-4">
                                <i class="lni lni-shopping-basket me-2"></i>Continue Shopping
                            </a>
                        </div>
                    </div>
                }
                else if (Model.Cancelled)
                {
                    <div class="alert alert-warning border-0 shadow-sm rounded-4 p-4 text-center">
                        <i class="lni lni-warning fs-1 d-block mb-3"></i>
                        <h4 class="fw-bold mb-2">Payment Cancelled</h4>
                        <p class="mb-1">You cancelled the payment. Your order is still saved.</p>
                        @if (Model.Retryable)
                        {
                            <p class="text-muted small mb-3">
                                @if (Model.AttemptsLeft > 0)
                                {
                                    <span>@Model.AttemptsLeft attempt@(Model.AttemptsLeft == 1 ? "" : "s") remaining.</span>
                                }
                            </p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <form asp-controller="Order" asp-action="RetryPayment" asp-route-id="@Model.OrderId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                                        <i class="lni lni-reload me-2"></i>Try Payment Again
                                    </button>
                                </form>
                                <a asp-controller="Order" asp-action="Detail" asp-route-id="@Model.OrderId"
                                   class="btn btn-outline-secondary rounded-pill px-4">
                                    <i class="lni lni-eye me-2"></i>View Order
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="text-danger small mb-3">No payment attempts remaining. Please contact support.</p>
                            <a asp-controller="Order" asp-action="Detail" asp-route-id="@Model.OrderId"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="lni lni-eye me-2"></i>View Order
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="alert alert-danger border-0 shadow-sm rounded-4 p-4 text-center">
                        <i class="lni lni-warning fs-1 d-block mb-3"></i>
                        <h4 class="fw-bold mb-2">Payment Failed</h4>
                        <p class="mb-1">@Model.Message</p>
                        @if (Model.Retryable)
                        {
                            <p class="text-muted small mb-3">
                                @if (Model.AttemptsLeft > 0)
                                {
                                    <span>@Model.AttemptsLeft attempt@(Model.AttemptsLeft == 1 ? "" : "s") remaining.</span>
                                }
                            </p>
                            <div class="d-flex gap-2 justify-content-center flex-wrap">
                                <form asp-controller="Order" asp-action="RetryPayment" asp-route-id="@Model.OrderId" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                                        <i class="lni lni-reload me-2"></i>Try Payment Again
                                    </button>
                                </form>
                                <a asp-controller="Order" asp-action="History"
                                   class="btn btn-outline-danger rounded-pill px-4">
                                    <i class="lni lni-list me-2"></i>My Orders
                                </a>
                            </div>
                        }
                        else
                        {
                            <p class="text-danger small mb-3">No payment attempts remaining. Please contact support.</p>
                            <a asp-controller="Order" asp-action="History"
                               class="btn btn-outline-danger rounded-pill px-4">
                                <i class="lni lni-list me-2"></i>My Orders
                            </a>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
</section>

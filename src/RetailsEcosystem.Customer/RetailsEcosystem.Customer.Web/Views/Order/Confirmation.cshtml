@using RetailsEcosystem.Customer.Shared.DTOs.Order
@model OrderDto
@{
    ViewData["Title"] = "Order Confirmed";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Start Breadcrumbs -->
<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Order Confirmed</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a asp-controller="Home" asp-action="Index"><i class="lni lni-home"></i> Home</a></li>
                    <li>Order Confirmed</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumbs -->

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                <!-- Success Banner -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 text-center p-5">
                    <div class="text-success mb-3">
                        <i class="lni lni-checkmark-circle" style="font-size:3rem;"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Thank you for your order!</h3>
                    <p class="text-muted mb-0">Order <strong>#@Model.Id</strong> has been placed successfully.</p>
                </div>

                <!-- Order Details -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3">Order Details</h5>

                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <div class="text-muted small">Order Number</div>
                                <div class="fw-semibold">#@Model.Id</div>
                            </div>
                            <div class="col-sm-6">
                                <div class="text-muted small">Status</div>
                                <span class="badge bg-warning text-dark">@Model.StatusLabel</span>
                            </div>
                            <div class="col-sm-6">
                                <div class="text-muted small">Order Date</div>
                                <div class="fw-semibold">@Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                            <div class="col-sm-6">
                                <div class="text-muted small">Shipping Address</div>
                                <div class="fw-semibold">@Model.ShippingAddress</div>
                            </div>
                        </div>

                        <!-- Items -->
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-center">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                                {
                                                    <img src="@item.ProductImageUrl" alt="@item.ProductName"
                                                         class="rounded-2" style="width:48px;height:48px;object-fit:cover;">
                                                }
                                                <span class="fw-semibold">@item.ProductName</span>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-center">@item.UnitPrice.ToString("C")</td>
                                        <td class="text-end fw-semibold">@item.LineTotal.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold">
                                    <td colspan="3" class="text-end">Grand Total</td>
                                    <td class="text-end">@Model.TotalAmount.ToString("C")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="d-flex gap-3 justify-content-center">
                    <a asp-controller="Order" asp-action="History"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="lni lni-list me-1"></i> My Orders
                    </a>
                    <a asp-controller="Products" asp-action="ProductIndex"
                       class="btn btn-primary rounded-pill px-4">
                        <i class="lni lni-shopping-basket me-1"></i> Continue Shopping
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>

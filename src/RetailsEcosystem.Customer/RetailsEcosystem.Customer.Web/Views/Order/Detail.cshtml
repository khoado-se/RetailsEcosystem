@using RetailsEcosystem.Customer.Shared.DTOs.Order
@using RetailsEcosystem.Customer.Shared.Enums
@model OrderDto
@{
    ViewData["Title"] = $"Order #{Model.Id}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Start Breadcrumbs -->
<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Order #@Model.Id</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a asp-controller="Home" asp-action="Index"><i class="lni lni-home"></i> Home</a></li>
                    <li><a asp-action="History">My Orders</a></li>
                    <li>Order #@Model.Id</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumbs -->

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success py-2 small mb-4">@TempData["SuccessMessage"]</div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger py-2 small mb-4">@TempData["ErrorMessage"]</div>
                }

                <!-- Status + Actions -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                            <div>
                                <h5 class="fw-bold mb-1">Order #@Model.Id</h5>
                                <div class="text-muted small">
                                    Placed on @Model.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                @{
                                    var badgeClass = Model.Status switch
                                    {
                                        OrderStatus.Pending   => "bg-warning text-dark",
                                        OrderStatus.Confirmed => "bg-info text-dark",
                                        OrderStatus.Shipped   => "bg-primary",
                                        OrderStatus.Delivered => "bg-success",
                                        OrderStatus.Cancelled => "bg-secondary",
                                        _ => "bg-secondary"
                                    };

                                    var paymentBadgeClass = Model.PaymentMethod == PaymentMethod.COD
                                        ? "bg-secondary bg-opacity-10 text-secondary"
                                        : Model.PaymentStatus switch
                                        {
                                            PaymentStatus.Paid            => "bg-success bg-opacity-10 text-success",
                                            PaymentStatus.AwaitingPayment => "bg-warning bg-opacity-10 text-warning",
                                            PaymentStatus.Failed          => "bg-danger bg-opacity-10 text-danger",
                                            _                             => "bg-secondary bg-opacity-10 text-secondary",
                                        };

                                    var paymentBadgeText = Model.PaymentMethod == PaymentMethod.COD
                                        ? "COD"
                                        : Model.PaymentStatus switch
                                        {
                                            PaymentStatus.Paid            => "Paid",
                                            PaymentStatus.AwaitingPayment => "Awaiting Payment",
                                            PaymentStatus.Failed          => "Payment Failed",
                                            PaymentStatus.Cancelled       => "Payment Cancelled",
                                            PaymentStatus.Expired         => "Payment Expired",
                                            PaymentStatus.Abandoned       => "Payment Abandoned",
                                            _                             => "Unpaid",
                                        };
                                }
                                <span class="badge @badgeClass fs-6 px-3 py-2">@Model.StatusLabel</span>
                                <span class="badge @paymentBadgeClass fs-6 px-3 py-2">
                                    <i class="lni lni-credit-cards me-1"></i>@paymentBadgeText
                                </span>

                                @if (Model.Status == OrderStatus.Pending)
                                {
                                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" id="cancelOrderForm">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn btn-outline-danger rounded-pill btn-sm px-3" id="cancelOrderBtn">
                                            Cancel Order
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>

                        @{
                            var retryablePayment = Model.PaymentMethod == PaymentMethod.VNPay
                                && Model.PaymentStatus is PaymentStatus.Pending
                                                       or PaymentStatus.AwaitingPayment
                                                       or PaymentStatus.Failed
                                                       or PaymentStatus.Cancelled
                                                       or PaymentStatus.Expired
                                                       or PaymentStatus.Abandoned;

                            var bannerAlertClass = Model.PaymentStatus switch
                            {
                                PaymentStatus.Failed   => "alert-danger",
                                PaymentStatus.Cancelled or PaymentStatus.Expired or PaymentStatus.Abandoned => "alert-secondary",
                                _ => "alert-warning",
                            };
                            var bannerIcon = Model.PaymentStatus switch
                            {
                                PaymentStatus.Failed    => "lni-close",
                                PaymentStatus.Cancelled => "lni-ban",
                                PaymentStatus.Expired   => "lni-timer",
                                PaymentStatus.Abandoned => "lni-exit",
                                _ => "lni-alarm",
                            };
                            var bannerTitle = Model.PaymentStatus switch
                            {
                                PaymentStatus.Failed    => "Payment failed",
                                PaymentStatus.Cancelled => "Payment cancelled",
                                PaymentStatus.Expired   => "Payment session expired",
                                PaymentStatus.Abandoned => "Payment not completed",
                                _ => "Payment pending",
                            };
                            var bannerDetail = Model.PaymentStatus switch
                            {
                                PaymentStatus.AwaitingPayment => Model.PaymentExpiresAt.HasValue
                                    ? $"Awaiting VNPay payment. Expires {Model.PaymentExpiresAt.Value.ToLocalTime():MMM dd, HH:mm}."
                                    : "Awaiting VNPay payment.",
                                PaymentStatus.Failed    => "Your last payment attempt was unsuccessful. You can try again.",
                                PaymentStatus.Cancelled => "You cancelled the payment. You can retry below.",
                                PaymentStatus.Expired   => "The payment window expired. Start a new payment to complete this order.",
                                PaymentStatus.Abandoned => "This order has not been paid. You can retry below.",
                                _ => "This order requires payment via VNPay.",
                            };
                        }
                        @if (retryablePayment)
                        {
                            const int maxAttempts = 3;
                            var attemptsLeft = maxAttempts - Model.PaymentAttemptCount;
                            var exhausted    = attemptsLeft <= 0;

                            <div class="alert @bannerAlertClass border-0 rounded-3 mt-3 mb-0 d-flex align-items-center gap-3 flex-wrap">
                                <i class="lni @bannerIcon flex-shrink-0 fs-5"></i>
                                <div class="flex-grow-1">
                                    <strong>@bannerTitle</strong> — @bannerDetail
                                    @if (!exhausted)
                                    {
                                        <span class="text-muted small ms-2">
                                            @attemptsLeft attempt@(attemptsLeft == 1 ? "" : "s") remaining.
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small ms-2">No payment attempts remaining. Please contact support.</span>
                                    }
                                </div>
                                @if (!exhausted)
                                {
                                    <form asp-action="RetryPayment" asp-route-id="@Model.Id" method="post" class="flex-shrink-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-primary btn-sm rounded-pill px-3">
                                            <i class="lni lni-credit-cards me-1"></i>Pay Now
                                        </button>
                                    </form>
                                }
                            </div>
                        }

                        <!-- Status Timeline -->
                        <div class="mt-4">
                            <div class="d-flex gap-2 flex-wrap">
                                @foreach (var status in new[] { OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Shipped, OrderStatus.Delivered })
                                {
                                    var isReached = (int)Model.Status >= (int)status && Model.Status != OrderStatus.Cancelled;
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                             style="width:32px;height:32px;font-size:0.75rem;
                                                    background:@(isReached ? "#4A90D9" : "#e9ecef");
                                                    color:@(isReached ? "white" : "#6c757d")">
                                            @((int)status + 1)
                                        </div>
                                        <span class="small @(isReached ? "fw-semibold" : "text-muted")">@status</span>
                                        @if (status != OrderStatus.Delivered)
                                        {
                                            <i class="lni lni-chevron-right text-muted small"></i>
                                        }
                                    </div>
                                }
                                @if (Model.Status == OrderStatus.Cancelled)
                                {
                                    <span class="badge bg-secondary ms-2 align-self-center">Cancelled</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Info -->
                <div class="row g-4 mb-4">
                    <div class="col-sm-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h6 class="fw-bold text-muted small text-uppercase mb-2">Shipping Address</h6>
                                <p class="mb-0">@Model.ShippingAddress</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body p-4">
                                <h6 class="fw-bold text-muted small text-uppercase mb-2">Last Updated</h6>
                                <p class="mb-0">@Model.UpdatedDate.ToLocalTime().ToString("MMM dd, yyyy HH:mm")</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Items -->
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Items Ordered</h5>
                        <table class="table table-hover align-middle">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-center">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                                {
                                                    <img src="@item.ProductImageUrl" alt="@item.ProductName"
                                                         class="rounded-2" style="width:52px;height:52px;object-fit:cover;">
                                                }
                                                <span class="fw-semibold">@item.ProductName</span>
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-center">@item.UnitPrice.ToString("C0")</td>
                                        <td class="text-end fw-semibold">@item.LineTotal.ToString("C0")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr class="fw-bold border-top">
                                    <td colspan="3" class="text-end">Grand Total</td>
                                    <td class="text-end">@Model.TotalAmount.ToString("C0")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- Confirm Cancel Order Modal -->
<div class="modal fade" id="confirmCancelOrderModal" tabindex="-1" aria-labelledby="confirmCancelOrderLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="confirmCancelOrderLabel">Cancel Order</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">Cancel this order? This action cannot be undone.</div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Keep Order</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmCancelOrderBtn">Cancel Order</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/order-detail.js" asp-append-version="true"></script>
}

@using RetailsEcosystem.Customer.Shared
@using RetailsEcosystem.Customer.Shared.DTOs.Order
@using RetailsEcosystem.Customer.Shared.Enums
@model PagedResult<OrderDto>
@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Start Breadcrumbs -->
<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">My Orders</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a asp-controller="Home" asp-action="Index"><i class="lni lni-home"></i> Home</a></li>
                    <li>My Orders</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumbs -->

<section class="section">
    <div class="container">

        @if (!Model.Items.Any())
        {
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center py-5">
                    <i class="lni lni-package fs-1 text-muted"></i>
                    <h4 class="mt-3">No orders yet</h4>
                    <p class="text-muted">You haven't placed any orders. Start shopping now!</p>
                    <a asp-controller="Products" asp-action="ProductIndex"
                       class="btn btn-primary rounded-pill px-4 mt-2">Browse Products</a>
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Date</th>
                                <th class="text-center">Items</th>
                                <th class="text-end">Total</th>
                                <th class="text-center">Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.Items)
                            {
                                <tr>
                                    <td class="fw-semibold">#@order.Id</td>
                                    <td class="text-muted small">@order.CreatedDate.ToLocalTime().ToString("MMM dd, yyyy")</td>
                                    <td class="text-center">@order.Items.Count</td>
                                    <td class="text-end fw-semibold">@order.TotalAmount.ToString("C0")</td>
                                    <td class="text-center">
                                        @{
                                            var badgeClass = order.Status switch
                                            {
                                                OrderStatus.Pending => "bg-warning text-dark",
                                                OrderStatus.Confirmed => "bg-info text-dark",
                                                OrderStatus.Shipped => "bg-primary",
                                                OrderStatus.Delivered => "bg-success",
                                                OrderStatus.Cancelled => "bg-secondary",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @badgeClass">@order.StatusLabel</span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="Detail" asp-route-id="@order.Id"
                                               class="btn btn-sm btn-outline-secondary rounded-pill">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            var firstItem = (Model.PageNumber - 1) * Model.PageSize + 1;
            var lastItem = firstItem + Model.Items.Count() - 1;

            var visiblePages = new SortedSet<int> { 1, Model.TotalPage };
            for (int d = -1; d <= 1; d++)
            {
                var pg = Model.PageNumber + d;
                if (pg >= 1 && pg <= Model.TotalPage) visiblePages.Add(pg);
            }
            
            <div class="mt-4 d-flex flex-column align-items-center gap-2">
                <p class="text-muted small mb-0">
                    Showing @firstItem–@lastItem of @Model.TotalCount orders
                </p>

                @if (Model.TotalPage > 1)
                {
                    <nav aria-label="Order history pagination">
                        <ul class="pagination mb-0">
                            <li class="page-item @(Model.PageNumber == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="History"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   aria-label="Previous">&#171;</a>
                            </li>

                            @{
                                int prevPage = 0;
                            }
                            @foreach (var p in visiblePages)
                            {
                                if (p - prevPage > 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">&#8230;</span>
                                    </li>
                                }
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="History"
                                       asp-route-pageNumber="@p">@p</a>
                                </li>
                                prevPage = p;
                            }

                            <li class="page-item @(Model.PageNumber == Model.TotalPage ? "disabled" : "")">
                                <a class="page-link" asp-action="History"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   aria-label="Next">&#187;</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }

    </div>
</section>

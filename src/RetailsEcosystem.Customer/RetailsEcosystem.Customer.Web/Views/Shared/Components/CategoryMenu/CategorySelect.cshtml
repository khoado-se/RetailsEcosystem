@using RetailsEcosystem.Customer.Shared
@model IEnumerable<CategoryDto>
@{
    int? selectedId   = ViewBag.CategoryId as int?;
    string? selectedName = Model.FirstOrDefault(c => c.Id == selectedId)?.Name;
}

<div data-category-select
     data-selected-id="@(selectedId?.ToString() ?? "")"
     data-selected-name="@(selectedName ?? "")"
     data-placeholder="All Categories"
     data-api-url="@ViewData["ApiCategoriesUrl"]">
</div>

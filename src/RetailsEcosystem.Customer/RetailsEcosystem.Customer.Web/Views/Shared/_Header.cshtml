@using RetailsEcosystem.Customer.Shared
@using System.Security.Claims
<!-- Preloader -->
<div class="preloader">
    <div class="preloader-inner">
        <div class="preloader-icon">
            <span></span>
            <span></span>
        </div>
    </div>
</div>
<!-- /End Preloader -->
<!-- Start Header Area -->
<header class="header navbar-area">

    <!-- Start Topbar -->
    <div class="topbar">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-5 col-md-5 d-none d-md-flex align-items-center gap-2">
                    <i class="lni lni-phone text-white"></i>
                    <span class="small text-white">Hotline: <strong>(+100) 123 456 7890</strong></span>
                </div>
                <div class="col-lg-7 col-md-7 col-12">
                    <div class="top-end">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var displayName = User.FindFirstValue(ClaimTypes.Name) ?? "User";
                            var initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";
                            <div class="d-flex align-items-center gap-3 justify-content-end">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                     style="width:26px;height:26px;font-size:0.7rem;">@initial</div>
                                <span class="small fw-medium d-none d-lg-inline text-white">@displayName</span>
                                <ul class="user-login mb-0">
                                    <li><a asp-controller="Account" asp-action="Profile">My Profile</a></li>
                                    <li><a asp-controller="Order" asp-action="History">My Orders</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-link p-0 text-decoration-none">Sign Out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2 justify-content-end">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-light fw-semibold">
                                    <i class="lni lni-user me-1"></i>Sign In
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary fw-semibold">Register</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Topbar -->

    <!-- Start Header Middle -->
    <div class="header-middle">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-2 col-md-3 col-5">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo/logo.svg" alt="Logo">
                    </a>
                </div>
                <div class="col-lg-7 col-md-5 d-none d-md-block">
                    <form method="get" asp-controller="Products" asp-action="ProductIndex" class="header-search-form">
                        <div class="input-group">
                            @await Component.InvokeAsync("CategoryMenu", new { viewName = "CategorySelect" })
                            <input type="text" name="search" class="form-control" placeholder="Search for products...">
                            <button class="btn btn-primary" type="submit" aria-label="Search">
                                <i class="lni lni-search-alt"></i>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-3 col-md-4 col-7">
                    <div class="navbar-cart justify-content-end">
                        <div class="wishlist">
                            <a href="javascript:void(0)" aria-label="Wishlist">
                                <i class="lni lni-heart"></i>
                                <span class="total-items">0</span>
                            </a>
                        </div>
                        <div class="cart-items">
                            <a asp-controller="Cart" asp-action="Index" class="main-btn" aria-label="Cart">
                                <i class="lni lni-cart"></i>
                                <span class="total-items" id="header-cart-count">0</span>
                            </a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- Shopping Item -->
                                <div class="shopping-item">
                                    <div class="dropdown-cart-header">
                                        <span><span id="header-cart-label">0</span> Items</span>
                                        <a asp-controller="Cart" asp-action="Index">View Cart</a>
                                    </div>
                                    <ul class="shopping-list" id="header-cart-list"></ul>
                                    <div class="bottom">
                                        <div class="total">
                                            <span>Total</span>
                                            <span class="total-amount" id="header-cart-total">$0.00</span>
                                        </div>
                                        <div class="button">
                                            <a asp-controller="Order" asp-action="Checkout" class="btn animate">Checkout</a>
                                        </div>
                                    </div>
                                </div>
                                <!--/ End Shopping Item -->
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Header Middle -->

    <!-- Start Header Bottom (Navigation) -->
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12">
                <div class="nav-inner">
                    <!-- Start Mega Category Menu -->
                    @await Component.InvokeAsync("CategoryMenu")
                    <!-- End Mega Category Menu -->

                    <!-- Start Navbar -->
                    <nav class="navbar navbar-expand-lg">
                        <button class="navbar-toggler mobile-menu-btn" type="button"
                                data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                                aria-controls="navbarSupportedContent" aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="toggler-icon"></span>
                            <span class="toggler-icon"></span>
                            <span class="toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse sub-menu-bar" id="navbarSupportedContent">
                            <ul id="nav" class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a asp-controller="Home" asp-action="Index" class="active" aria-label="Home">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Products" asp-action="ProductIndex" aria-label="Shop">Shop</a>
                                </li>
                                <li class="nav-item">
                                    <a href="javascript:void(0)" aria-label="Contact Us">Contact Us</a>
                                </li>
                            </ul>
                        </div>
                    </nav>
                    <!-- End Navbar -->
                </div>
            </div>
        </div>
    </div>
    <!-- End Header Bottom -->

</header>
<!-- End Header Area -->

@using RetailsEcosystem.Customer.Shared
@using System.Security.Claims
@{
    var currentCtrl   = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!-- Preloader -->
<div class="preloader">
    <div class="preloader-inner">
        <div class="preloader-icon">
            <span></span>
            <span></span>
        </div>
    </div>
</div>
<!-- /End Preloader -->
<!-- Start Header Area -->
<header class="header navbar-area">

    <!-- Start Header Middle -->
    <div class="header-middle">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-2 col-md-3 col-5">
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                        <img src="~/images/logo/logo.svg" alt="Logo">
                    </a>
                </div>
                <div class="col-lg-7 col-md-5 d-none d-md-block">
                    <form method="get" asp-controller="Products" asp-action="ProductIndex"
                          class="header-search-form" id="header-search-form">
                        <div class="input-group">
                            <input type="text" name="search" id="header-search-input"
                                   class="form-control" placeholder="Search for products..."
                                   value="@(ViewBag.Search?.ToString() ?? "")">
                            <button type="button" class="btn btn-outline-secondary header-search-clear"
                                    id="header-search-clear" aria-label="Clear search" hidden>
                                <i class="lni lni-close"></i>
                            </button>
                            <button class="btn btn-primary" type="submit" aria-label="Search">
                                <i class="lni lni-search-alt"></i>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="col-lg-3 col-md-4 col-7">
                    <div class="navbar-cart justify-content-end">
                        <div class="wishlist">
                            <a href="javascript:void(0)" aria-label="Wishlist">
                                <i class="lni lni-heart"></i>
                                <span class="total-items">0</span>
                            </a>
                        </div>
                        <div class="cart-items">
                            <a asp-controller="Cart" asp-action="Index" class="main-btn" aria-label="Cart">
                                <i class="lni lni-cart"></i>
                                <span class="total-items" id="header-cart-count">0</span>
                            </a>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <!-- Shopping Item -->
                                <div class="shopping-item">
                                    <div class="dropdown-cart-header">
                                        <span><span id="header-cart-label">0</span> Items</span>
                                        <a asp-controller="Cart" asp-action="Index">View Cart</a>
                                    </div>
                                    <ul class="shopping-list" id="header-cart-list"></ul>
                                    <div class="bottom">
                                        <div class="total">
                                            <span>Total</span>
                                            <span class="total-amount" id="header-cart-total">$0.00</span>
                                        </div>
                                        <div class="button">
                                            <a asp-controller="Order" asp-action="Checkout" class="btn animate">Checkout</a>
                                        </div>
                                    </div>
                                </div>
                                <!--/ End Shopping Item -->
                            }
                        </div>

                        @* ── User menu ── *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var displayName = User.FindFirstValue(ClaimTypes.Name) ?? "User";
                            var initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "U";
                            var avatarUrl = User.FindFirstValue("avatar_url");
                            <div class="user-menu">
                                <div class="user-menu__trigger" aria-label="User menu">
                                    <div class="user-avatar" id="header-user-avatar">
                                        @if (!string.IsNullOrEmpty(avatarUrl))
                                        {
                                            <img src="@avatarUrl" alt="@displayName" />
                                        }
                                        else
                                        {
                                            @initial
                                        }
                                    </div>
                                    <i class="lni lni-chevron-down user-menu__caret"></i>
                                </div>
                                <div class="user-menu__dropdown">
                                    <div class="user-menu__header">
                                        <span class="user-menu__name">@displayName</span>
                                        @{
                                            var userPhone = User.FindFirstValue("phone_number");
                                            var userEmail = User.FindFirstValue(ClaimTypes.Email);
                                        }
                                        <span class="user-menu__hotline">
                                            @if (!string.IsNullOrWhiteSpace(userPhone))
                                            {
                                                <i class="lni lni-phone me-1"></i>@userPhone
                                            }
                                            else if (!string.IsNullOrWhiteSpace(userEmail))
                                            {
                                                <i class="lni lni-envelope me-1"></i>@userEmail
                                            }
                                        </span>
                                    </div>
                                    <ul class="user-menu__list">
                                        <li>
                                            <a asp-controller="Account" asp-action="Profile">
                                                <i class="lni lni-user"></i>My Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a asp-controller="Order" asp-action="History">
                                                <i class="lni lni-package"></i>My Orders
                                            </a>
                                        </li>
                                    </ul>
                                    <div class="user-menu__footer">
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit">
                                                <i class="lni lni-exit"></i>Sign Out
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="user-menu user-menu--guest">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-secondary fw-semibold">
                                    <i class="lni lni-user me-1"></i><span class="d-none d-lg-inline">Sign In</span>
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-sm btn-primary fw-semibold d-none d-lg-inline-flex">
                                    Register
                                </a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- End Header Middle -->

    <!-- Start Header Bottom (Navigation) -->
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12">
                <div class="nav-inner">
                    <!-- Start Navbar -->
                    <nav class="navbar navbar-expand-lg">
                        <button class="navbar-toggler mobile-menu-btn" type="button"
                                data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                                aria-controls="navbarSupportedContent" aria-expanded="false"
                                aria-label="Toggle navigation">
                            <span class="toggler-icon"></span>
                            <span class="toggler-icon"></span>
                            <span class="toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse sub-menu-bar" id="navbarSupportedContent">
                            <ul id="nav" class="navbar-nav ms-auto">
                                <li class="nav-item">
                                    <a asp-controller="Home" asp-action="Index"
                                       class="@(currentCtrl == "Home" && currentAction == "Index" ? "active" : "")"
                                       aria-label="Home">Home</a>
                                </li>
                                <li class="nav-item">
                                    <a asp-controller="Products" asp-action="ProductIndex"
                                       class="@(currentCtrl == "Products" ? "active" : "")"
                                       aria-label="Shop">Shop</a>
                                </li>
                                <li class="nav-item">
                                    <a href="javascript:void(0)" aria-label="Contact Us">Contact Us</a>
                                </li>
                            </ul>
                        </div>
                    </nav>
                    <!-- End Navbar -->
                </div>
            </div>
        </div>
    </div>
    <!-- End Header Bottom -->

</header>
<!-- End Header Area -->

@using Microsoft.Extensions.Options
@using RetailsEcosystem.Customer.Shared
@using RetailsEcosystem.Customer.Web.Options
@model PagedResult<ProductDto>
@inject IOptions<ApiSettings> ApiOptions
@{
    int? categoryId = ViewBag.CategoryId as int?;
    string? search = ViewBag.Search as string;
    var selectedCatName = categoryId.HasValue
        ? ((IEnumerable<CategoryDto>)ViewBag.Categories)
              .FirstOrDefault(c => c.Id == categoryId)?.Name ?? ""
        : "";
}

@* Filter Toolbar — search lives in the header *@
<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <form method="get" asp-controller="Products" asp-action="ProductIndex"
          class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
        <input type="hidden" name="search" value="@search" />

        <div class="col-auto" style="min-width: 180px;">
            <div data-category-select
                 data-selected-id="@(categoryId?.ToString() ?? "")"
                 data-selected-name="@selectedCatName"
                 data-placeholder="All Categories"
                 data-api-url="@($"{ApiOptions.Value.BaseUrl.TrimEnd('/')}/api/categories")">
            </div>
        </div>

        <button type="submit" class="btn btn-sm btn-primary">
            <i class="lni lni-funnel me-1"></i>Filter
        </button>

        @if (!string.IsNullOrWhiteSpace(search) || categoryId.HasValue)
        {
            <a asp-controller="Products" asp-action="ProductIndex"
                   class="btn btn-sm btn-outline-secondary">
                <i class="lni lni-close me-1"></i>Clear
            </a>
        }
    </form>

    @if (!string.IsNullOrWhiteSpace(search))
    {
        <span class="badge bg-light text-dark border ms-auto">
            <i class="lni lni-search-alt me-1 text-muted"></i>@search
        </span>
    }
</div>

@if (!Model.Items.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="lni lni-search-alt" style="font-size:2.5rem;"></i>
        <p class="mt-3 mb-0 fw-semibold">No products found</p>
        <p class="small">Try a different search term or category.</p>
        <a asp-controller="Products" asp-action="ProductIndex" class="btn btn-outline-primary btn-sm mt-2">Clear filters</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model.Items)
        {
            var baseUrl = ApiOptions.Value.BaseUrl;
            var imageUrl = item.ImageUrl;
            var hasImage = !string.IsNullOrEmpty(imageUrl);
            if (!hasImage)
                imageUrl = $"{baseUrl}/images/products/product-placeholder-image.jpg";

            <div class="col-xl-3 col-lg-4 col-md-6 col-12">
                <div class="best-seller-card">

                    <div class="card-img-wrapper">
                        @if (hasImage)
                        {
                            <img src="@imageUrl" alt="@item.Name" class="card-img-top">
                        }
                        else
                        {
                            <div class="card-img-placeholder">
                                <i class="lni lni-image"></i>
                            </div>
                        }

                        @* Stock badge — top right *@
                        @if (item.StockQuantity > 0)
                        {
                            <span class="badge-stock in-stock">In Stock</span>
                        }
                        else
                        {
                            <span class="badge-stock out-of-stock">Out of Stock</span>
                        }

                        @* Quick cart icon — bottom right *@
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="btn-cart-icon"
                                    data-action="add-to-cart"
                                    data-product-id="@item.Id"
                                    title="Add to Cart"
                                    @(item.StockQuantity == 0 ? "disabled" : "")>
                                <i class="lni lni-cart"></i>
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               asp-route-returnUrl="@Url.Action("ProductIndex", "Products")"
                               class="btn-cart-icon" title="Sign in to add to cart">
                                <i class="lni lni-cart"></i>
                            </a>
                        }
                    </div>

                    <div class="card-body">
                        <p class="card-category">@item.Category?.Name</p>
                        <a asp-controller="Products" asp-action="ProductDetails"
                           asp-route-id="@item.Id"
                           class="card-product-name">@item.Name</a>
                        <p class="card-price">@item.Price.ToString("C0")</p>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button class="btn btn-add-cart"
                                    data-action="add-to-cart"
                                    data-product-id="@item.Id"
                                    @(item.StockQuantity == 0 ? "disabled" : "")>
                                @(item.StockQuantity == 0 ? "Out of Stock" : "Add to Cart")
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               asp-route-returnUrl="@Url.Action("ProductIndex", "Products")"
                               class="btn btn-add-cart">Add to Cart</a>
                        }
                    </div>

                </div>
            </div>
        }
    </div>

    @* Pagination — only shown when more than one page *@
    @if (Model.TotalPage > 1)
    {
        <nav aria-label="Product pages" class="d-flex justify-content-center mt-3">
            <ul class="pagination">
                <li class="page-item @(Model.PageNumber - 1 > 0 ? "" : "disabled")">
                    <a class="page-link" tabindex="-1" aria-disabled="true"
                       asp-controller="Products" asp-action="ProductIndex"
                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                       asp-route-categoryId="@categoryId"
                       asp-route-search="@search">Previous</a>
                </li>
                @if (Model.PageNumber - 1 > 0)
                {
                    <li class="page-item">
                        <a class="page-link"
                               asp-controller="Products" asp-action="ProductIndex"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-categoryId="@categoryId"
                               asp-route-search="@search">
                            @(Model.PageNumber - 1)
                        </a>
                    </li>
                }
                <li class="page-item active" aria-current="page">
                    <a class="page-link" href="#">@Model.PageNumber</a>
                </li>
                @if (Model.PageNumber + 1 <= Model.TotalPage)
                {
                    <li class="page-item">
                        <a class="page-link"
                               asp-controller="Products" asp-action="ProductIndex"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-categoryId="@categoryId"
                               asp-route-search="@search">
                            @(Model.PageNumber + 1)
                        </a>
                    </li>
                }
                <li class="page-item @(Model.PageNumber + 1 <= Model.TotalPage ? "" : "disabled")">
                    <a class="page-link"
                       asp-controller="Products" asp-action="ProductIndex"
                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                       asp-route-categoryId="@categoryId"
                       asp-route-search="@search">Next</a>
                </li>
            </ul>
        </nav>
    }
}

@section Styles {
    <link href="~/css/home/featuredProducts.css" rel="stylesheet" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/products.js" asp-append-version="true"></script>
}

@using RetailsEcosystem.Customer.Shared
@model ProductDto

<div class="pdp-wrapper container py-4">
    <div class="row g-5 align-items-start">

        @* ── Left: image gallery ── *@
        <div class="col-lg-5 col-12">
            <div class="pdp-gallery @(Model.ImageUrls.Count <= 1 ? "pdp-gallery--single" : "")">

                @* Main image *@
                <div class="pdp-gallery__main mb-3">
                    @if (Model.ImageUrls.Count > 0)
                    {
                        <img src="@Model.ImageUrls[0]" id="current" alt="@Model.Name">
                    }
                    else
                    {
                        <img src="~/images/product-placeholder.jpg" id="current" alt="@Model.Name">
                    }
                </div>

                @* Thumbnails *@
                @if (Model.ImageUrls.Count > 1)
                {
                    <div class="pdp-gallery__thumbs">
                        @foreach (var imgUrl in Model.ImageUrls)
                        {
                            <img src="@imgUrl" class="pdp-thumb" alt="@Model.Name">
                        }
                    </div>
                }
            </div>
        </div>

        @* ── Right: product info (sticky) ── *@
        <div class="col-lg-7 col-12">
            <div class="pdp-info">

                @* Category *@
                <p class="pdp-category">
                    <a asp-controller="Products" asp-action="ProductIndex"
                       asp-route-categoryId="@Model.Category.Id">@Model.Category.Name</a>
                </p>

                @* Name *@
                <h1 class="pdp-name">@Model.Name</h1>

                @* Price *@
                <p class="pdp-price">@Model.Price.ToString("C0")</p>

                @* Stock *@
                @if (Model.StockQuantity > 10)
                {
                    <p class="stock-indicator stock-indicator--in">
                        <i class="lni lni-checkmark-circle"></i>In Stock
                    </p>
                }
                else if (Model.StockQuantity > 0)
                {
                    <p class="stock-indicator stock-indicator--low">
                        <i class="lni lni-warning"></i>Only @Model.StockQuantity left in stock!
                    </p>
                }
                else
                {
                    <p class="stock-indicator stock-indicator--out">
                        <i class="lni lni-close"></i>Out of Stock
                    </p>
                }

                <hr class="pdp-divider">

                @* Action block *@
                @if (Model.StockQuantity > 0)
                {
                    <div class="pdp-actions">
                        <div class="pdp-qty-block">
                            <label class="pdp-qty-label">Quantity</label>
                            <div class="pdp-qty-stepper">
                                <button type="button" data-action="qty-dec">−</button>
                                <input type="number" id="quantity" class="qty-input"
                                       value="1" min="1" max="@Model.StockQuantity">
                                <button type="button" data-action="qty-inc">+</button>
                            </div>
                        </div>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <button id="add-to-cart-btn" class="pdp-btn-cart"
                                    data-action="add-to-cart" data-product-id="@Model.Id">
                                <i class="lni lni-cart"></i>Add to Cart
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login"
                               asp-route-returnUrl="@Url.Action("ProductDetails", "Products", new { id = Model.Id })"
                               class="pdp-btn-cart">
                                <i class="lni lni-cart"></i>Add to Cart
                            </a>
                        }
                    </div>
                }
                else
                {
                    <button class="pdp-btn-cart pdp-btn-cart--disabled" disabled>
                        Out of Stock
                    </button>
                }

            </div>
        </div>
    </div>

    @* ── Description ── *@
    @if (!string.IsNullOrWhiteSpace(Model.Description))
    {
        <div class="pdp-description">
            <h5 class="pdp-description__title">Description</h5>
            <p class="pdp-description__body">@Model.Description</p>
        </div>
    }
</div>

@section Styles {
    <link href="~/css/products/product-details.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/product-details.js" asp-append-version="true"></script>
}

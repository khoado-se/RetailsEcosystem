@using RetailsEcosystem.Customer.Shared
@model ProductDto
<!-- Start Item Details -->
<section class="item-details section">
    <div class="container">
        <div class="top-area">
            <div class="row align-items-center">
                <div class="col-lg-6 col-md-12 col-12">
                    <div class="product-images">
                        <main id="gallery" class="@(Model.ImageUrls.Count <= 1 ? "single-image" : "")">
                            <div class="main-img">
                                @if (Model.ImageUrls.Count > 0)
                                {
                                    <img src="@Model.ImageUrls[0]" id="current" alt="@Model.Name">
                                }
                                else
                                {
                                    <img src="~/images/product-placeholder.jpg" id="current" alt="@Model.Name">
                                }
                            </div>
                            <div class="images">
                                @foreach (var imgUrl in Model.ImageUrls)
                                {
                                    <img src="@imgUrl" class="img" alt="@Model.Name">
                                }
                            </div>
                        </main>
                    </div>
                </div>
                <div class="col-lg-6 col-md-12 col-12">
                    <div class="product-info">
                        <h2 class="title">@Model.Name</h2>
                        <p class="category">
                            <a asp-controller="Products"
                               asp-action="ProductIndex"
                               asp-route-categoryId="@Model.Category.Id">@Model.Category.Name</a>
                        </p>
                        <h3 class="price">@Model.Price.ToString("N0") ₫</h3>
                        <p class="info-text">@Model.Description</p>

                        @if (Model.StockQuantity > 0)
                        {
                            <span class="stock-badge in-stock">
                                <i class="lni lni-checkmark-circle"></i> In Stock (@Model.StockQuantity available)
                            </span>
                        }
                        else
                        {
                            <span class="stock-badge out-of-stock">
                                <i class="lni lni-close"></i> Out of Stock
                            </span>
                        }

                        <div class="row mt-3">
                            <div class="col-lg-5 col-md-5 col-12">
                                <div class="form-group quantity">
                                    <label for="quantity">Quantity</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <button class="btn btn-outline-secondary" type="button" data-action="qty-dec">-</button>
                                        </div>
                                        <input type="number" id="quantity" class="form-control qty-input text-center" value="1" min="1" max="@Model.StockQuantity">
                                        <div class="input-group-append">
                                            <button class="btn btn-outline-secondary" type="button" data-action="qty-inc">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="details-alert" class="alert d-none mb-3"></div>
                        <div class="bottom-content">
                            <div class="row align-items-end">
                                <div class="col-lg-4 col-md-4 col-12">
                                    <div class="button cart-button">
                                        @if (User.Identity?.IsAuthenticated == true)
                                        {
                                            <button id="add-to-cart-btn" class="btn btn-add-cart-detail"
                                                    data-action="add-to-cart"
                                                    data-product-id="@Model.Id"
                                                    @(Model.StockQuantity == 0 ? "disabled" : "")>
                                                @(Model.StockQuantity == 0 ? "Out of Stock" : "Add to Cart")
                                            </button>
                                        }
                                        else
                                        {
                                            <a asp-controller="Account" asp-action="Login"
                                               asp-route-returnUrl="@Url.Action("ProductDetails", "Products", new { productId = Model.Id })"
                                               class="btn btn-add-cart-detail">Add to Cart</a>
                                        }
                                    </div>
                                </div>
                                <div class="col-lg-4 col-md-4 col-12">
                                    <div class="wish-button">
                                        <button class="btn"><i class="lni lni-heart"></i> Wishlist</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="product-details-info">
            <div class="single-block">
                <div class="row">
                    <div class="col-lg-6 col-12">
                        <div class="info-body custom-responsive-margin">
                            <h4>Description</h4>
                            <p>@Model.Description</p>
                        </div>
                    </div>
                    <div class="col-lg-6 col-12">
                        <div class="info-body">
                            <h4>Product Information</h4>
                            <ul class="normal-list">
                                <li><span>Category:</span> @Model.Category.Name</li>
                                <li><span>SKU:</span> #@Model.Id.ToString("D6")</li>
                                <li>
                                    <span>Availability:</span>
                                    @(Model.StockQuantity > 0
                                        ? $"In Stock ({Model.StockQuantity} units)"
                                        : "Out of Stock")
                                </li>
                                <li><span>Added:</span> @Model.CreatedDate.ToString("MMMM yyyy")</li>
                            </ul>
                            <h4>Shipping Options</h4>
                            <ul class="normal-list">
                                <li><span>Courier:</span> 2–4 days, $22.50</li>
                                <li><span>Local Shipping:</span> up to one week, $10.00</li>
                                <li><span>UPS Ground:</span> 4–6 days, $18.00</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Item Details -->

@section Styles {
    <link href="~/css/products/product-details.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/js/product-details.js" asp-append-version="true"></script>
}

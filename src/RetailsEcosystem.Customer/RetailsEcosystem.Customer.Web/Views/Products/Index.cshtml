@using RetailsEcosystem.Customer.Shared
@model PagedResult<ProductDto>

<div class="container product-card row">
     @foreach (var item in Model.Items)
    {
        <div class="card col-xl-3 col-lg-4 col-md-6 col-sm-1 my-3">
            <!-- Carousel -->
            <div id="slideshow-@item.Id" class="carousel slide" data-bs-ride="carousel">

                <!-- Indicators/dots -->
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#slideshow-@item.Id" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#slideshow-@item.Id" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#slideshow-@item.Id" data-bs-slide-to="2"></button>
                </div>

                <!-- The slideshow/carousel -->
                <div class="carousel-inner">
                    <div class="carousel-item active">
                        <img src="https://images.pexels.com/photos/2529148/pexels-photo-2529148.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" alt="product image" class="d-block card-img-top img-fluid mx-auto d-block img-rounded" style="width:100%">
                    </div>
                    <div class="carousel-item">
                        <img src="https://images.pexels.com/photos/2529146/pexels-photo-2529146.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" alt="product image" class="d-block card-img-top img-fluid mx-auto d-block img-rounded" style="width:100%">
                    </div>
                    <div class="carousel-item">
                        <img src="https://images.pexels.com/photos/2529147/pexels-photo-2529147.jpeg?auto=compress&cs=tinysrgb&dpr=2&h=650&w=940" alt="product image" class="d-block card-img-top img-fluid mx-auto d-block img-rounded" style="width:100%">
                    </div>
                </div>

                <!-- Left and right controls/icons -->
                <button class="carousel-control-prev" type="button" data-bs-target="#slideshow-@item.Id" data-bs-slide="prev">
                    <i class="fas fa-caret-square-left"></i>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#slideshow-@item.Id" data-bs-slide="next">
                    <i class="fas fa-caret-square-right"></i>
                </button>
            </div>


            <div class="card-body ">
                <p class="price"><h4>£60.99</h4></p>
                <h2 class="card-title">Product's Description</h2>
                <p class="card-text">Some example text. Some example text.</p>
                <p><a href="#" id="addToCard" class="btn btn-success">Add To Card</a></p>
            </div>

        </div>
    }
</div>

<nav aria-label="..." class="d-flex justify-content-center">
    <ul class="pagination">
        <li class="page-item @(Model.PageNumber - 1 > 0 ? "" : "disabled")">
            <a class="page-link" tabindex="-1" aria-disabled="true"
               asp-controller="Products"
               asp-action="Index"
               asp-route-pageNumber="@(Model.PageNumber - 1)"
               asp-route-pageSize="@Model.PageSize"
            >Previous</a>
        </li>
        @if (Model.PageNumber - 1 > 0)
        {
           <li class="page-item">
                <a class="page-link"
                    asp-controller="Products" 
                    asp-action="Index" 
                    asp-route-pageNumber="@(Model.PageNumber - 1)" 
                    asp-route-pageSize="@Model.PageSize"
                    >@(Model.PageNumber - 1)
               </a>
           </li>
        }
        <li class="page-item active" aria-current="page">
            <a class="page-link" href="#">@Model.PageNumber</a>
        </li>
        @if (Model.PageNumber + 1 <= Model.TotalPage)
        {
            <li class="page-item">
                <a class="page-link" 
                    asp-controller="Products" 
                    asp-action="Index" 
                    asp-route-pageNumber="@(Model.PageNumber + 1)" 
                    asp-route-pageSize="@Model.PageSize"
                    >@(Model.PageNumber + 1)
                </a>
            </li>
        }
        <li class="page-item @(Model.PageNumber + 1 <= Model.TotalPage ? "" : "disabled")">
            <a class="page-link" 
            asp-controller="Products" 
            asp-action="Index" 
            asp-route-pageNumber="@(Model.PageNumber + 1)" 
            asp-route-pageSize="@Model.PageSize"
            >Next</a>
        </li>
    </ul>
</nav>

@section Styles {
    <link href="~/css/products/card.css" rel="stylesheet" />
}
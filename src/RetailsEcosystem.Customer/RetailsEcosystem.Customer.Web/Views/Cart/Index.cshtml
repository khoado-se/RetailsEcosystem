@using RetailsEcosystem.Customer.Shared.DTOs.Cart
@model CartDto
@{
    ViewData["Title"] = "My Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isEmpty = !Model.Items.Any();
}

<!-- Start Breadcrumbs -->
<div class="breadcrumbs">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 col-md-6 col-12">
                <div class="breadcrumbs-content">
                    <h1 class="page-title">Shopping Cart</h1>
                </div>
            </div>
            <div class="col-lg-6 col-md-6 col-12">
                <ul class="breadcrumb-nav">
                    <li><a asp-controller="Home" asp-action="Index"><i class="lni lni-home"></i> Home</a></li>
                    <li>Cart</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumbs -->

<!-- Start Shopping Cart -->
<div class="shopping-cart section">
    <div class="container">

        @if (isEmpty)
        {
            <div class="row justify-content-center">
                <div class="col-lg-6 text-center py-5">
                    <i class="lni lni-cart fs-1 text-muted"></i>
                    <h4 class="mt-3">Your cart is empty</h4>
                    <p class="text-muted">Browse our products and add something you like.</p>
                    <a asp-controller="Products" asp-action="ProductIndex"
                       class="btn btn-primary rounded-pill px-4 mt-2">Continue Shopping</a>
                </div>
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12">
                    @if (ViewBag.StockWarnings is IEnumerable<string> stockWarnings && stockWarnings.Any())
                    {
                        <div class="alert alert-warning d-flex align-items-start gap-2 rounded-3 mb-4" role="alert">
                            <i class="lni lni-warning flex-shrink-0 mt-1"></i>
                            <div>
                                <strong>Stock update</strong>
                                <ul class="mb-0 mt-1">
                                    @foreach (var w in stockWarnings)
                                    {
                                        <li>@w</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                    <div id="cart-alert" class="alert d-none"></div>

                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-0">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th class="text-center">Price</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-center">Total</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody id="cart-body">
                                    @foreach (var item in Model.Items)
                                    {
                                        <tr id="cart-row-@item.Id">
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                                                    {
                                                        <img src="@item.ProductImageUrl" alt="@item.ProductName"
                                                             class="rounded-2"
                                                             style="width:64px;height:64px;object-fit:cover;">
                                                    }
                                                    <span class="fw-semibold">@item.ProductName</span>
                                                </div>
                                            </td>
                                            <td class="text-center">@item.UnitPrice.ToString("C")</td>
                                            <td class="text-center" style="width:160px;">
                                                <div class="input-group input-group-sm justify-content-center">
                                                    <button class="btn btn-outline-secondary"
                                                            data-action="qty-dec" data-item-id="@item.Id">−</button>
                                                    <input type="number" id="qty-@item.Id"
                                                           class="form-control text-center"
                                                           style="max-width:56px;"
                                                           value="@item.Quantity" min="1"
                                                           data-action="qty-change" data-item-id="@item.Id">
                                                    <button class="btn btn-outline-secondary"
                                                            data-action="qty-inc" data-item-id="@item.Id">+</button>
                                                </div>
                                            </td>
                                            <td class="text-center fw-semibold" id="line-@item.Id">@item.LineTotal.ToString("C")</td>
                                            <td class="text-center">
                                                <button class="btn btn-sm btn-outline-danger rounded-pill"
                                                        data-action="remove-item" data-item-id="@item.Id">
                                                    <i class="lni lni-close"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-lg-6">
                            <form asp-action="Clear" asp-controller="Cart" method="post" id="clearCartForm">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-outline-secondary rounded-pill" id="clearCartBtn">
                                    <i class="lni lni-trash-can me-1"></i> Clear Cart
                                </button>
                            </form>
                        </div>
                        <div class="col-lg-6">
                            <div class="card border-0 shadow-sm">
                                <div class="card-body p-4">
                                    <h5 class="fw-bold mb-3">Order Summary</h5>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Subtotal (<span id="summary-count">@Model.ItemCount</span> items)</span>
                                        <span id="summary-total" class="fw-semibold">@Model.Total.ToString("C")</span>
                                    </div>
                                    <hr>
                                    <div class="d-flex justify-content-between mb-3 fw-bold">
                                        <span>Grand Total</span>
                                        <span id="grand-total">@Model.Total.ToString("C")</span>
                                    </div>
                                    <a asp-controller="Order" asp-action="Checkout"
                                       class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">
                                        Proceed to Checkout
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        }

    </div>
</div>
<!-- End Shopping Cart -->

<!-- Confirm Remove Item Modal -->
<div class="modal fade" id="confirmRemoveModal" tabindex="-1" aria-labelledby="confirmRemoveLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="confirmRemoveLabel">Remove Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">Remove this item from your cart?</div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmRemoveBtn">Remove</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirm Clear Cart Modal -->
<div class="modal fade" id="confirmClearModal" tabindex="-1" aria-labelledby="confirmClearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-3 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="confirmClearLabel">Clear Cart</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">Remove all items from your cart? This cannot be undone.</div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger rounded-pill px-4" id="confirmClearBtn">Clear Cart</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/cart.js" asp-append-version="true"></script>
}

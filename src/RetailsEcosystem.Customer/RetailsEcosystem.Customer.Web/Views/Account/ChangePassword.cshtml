@model RetailsEcosystem.Customer.Web.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7 col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h2 class="text-page-title mb-1">Change Password</h2>
                        <p class="text-muted text-body-sm mb-4">Choose a strong password.</p>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger d-flex align-items-start gap-2 rounded-3 py-2 px-3 mb-4" role="alert">
                                <i class="lni lni-warning flex-shrink-0 mt-1 text-caption"></i>
                                <span class="text-body-sm">@Html.ValidationSummary(false)</span>
                            </div>
                        }

                        <form asp-action="ChangePassword" asp-controller="Account" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="CurrentPassword" class="form-label text-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="lni lni-lock text-muted"></i>
                                    </span>
                                    <input asp-for="CurrentPassword" type="password"
                                           class="form-control border-start-0 border-end-0 bg-light"
                                           placeholder="••••••••" autocomplete="current-password" />
                                    <button type="button"
                                            class="input-group-text bg-light border-start-0 password-toggle"
                                            tabindex="-1" aria-label="Toggle password visibility">
                                        <i class="lni lni-eye text-muted opacity-50"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="CurrentPassword" class="text-danger text-caption"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label text-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="lni lni-lock text-muted"></i>
                                    </span>
                                    <input asp-for="NewPassword" type="password"
                                           class="form-control border-start-0 border-end-0 bg-light"
                                           placeholder="At least 8 characters" autocomplete="new-password" />
                                    <button type="button"
                                            class="input-group-text bg-light border-start-0 password-toggle"
                                            tabindex="-1" aria-label="Toggle password visibility">
                                        <i class="lni lni-eye text-muted opacity-50"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="NewPassword" class="text-danger text-caption"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmNewPassword" class="form-label text-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="lni lni-lock text-muted"></i>
                                    </span>
                                    <input asp-for="ConfirmNewPassword" type="password"
                                           class="form-control border-start-0 border-end-0 bg-light"
                                           placeholder="Repeat new password" autocomplete="new-password" />
                                    <button type="button"
                                            class="input-group-text bg-light border-start-0 password-toggle"
                                            tabindex="-1" aria-label="Toggle password visibility">
                                        <i class="lni lni-eye text-muted opacity-50"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger text-caption"></span>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary fw-semibold">
                                    <i class="lni lni-checkmark-circle me-2"></i>Update Password
                                </button>
                                <a asp-action="Profile" asp-controller="Account"
                                   class="btn btn-outline-secondary fw-semibold">
                                    Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/auth.js" asp-append-version="true"></script>
}

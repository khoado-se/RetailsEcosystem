@model RetailsEcosystem.Customer.Web.Models.Account.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Start Account Section -->
<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7 col-12">
                <div class="card shadow-sm border-0 rounded-4 p-4">
                    <div class="card-body">
                        <h4 class="fw-bold mb-1">Change Password</h4>
                        <p class="text-muted small mb-4">Choose a strong password.</p>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <form asp-action="ChangePassword" asp-controller="Account" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="CurrentPassword" class="form-label fw-semibold small"></label>
                                <input asp-for="CurrentPassword" type="password" class="form-control rounded-3"
                                       placeholder="••••••••" autocomplete="current-password" />
                                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label fw-semibold small"></label>
                                <input asp-for="NewPassword" type="password" class="form-control rounded-3"
                                       placeholder="At least 8 characters" autocomplete="new-password" />
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="ConfirmNewPassword" class="form-label fw-semibold small"></label>
                                <input asp-for="ConfirmNewPassword" type="password" class="form-control rounded-3"
                                       placeholder="Repeat new password" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary rounded-pill py-2 px-4 fw-semibold">
                                    Update Password
                                </button>
                                <a asp-action="Profile" asp-controller="Account"
                                   class="btn btn-outline-secondary rounded-pill py-2 px-4 fw-semibold">
                                    Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Account Section -->

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

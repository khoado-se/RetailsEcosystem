@model RetailsEcosystem.Customer.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Start Account Section -->
<section class="account-login section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7 col-12">
                <div class="card shadow-sm border-0 rounded-4 p-4">
                    <div class="card-body">
                        <h4 class="fw-bold mb-1">Sign In</h4>
                        <p class="text-muted small mb-4">Welcome back! Please enter your details.</p>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger py-2 small">
                                @Html.ValidationSummary(false)
                            </div>
                        }

                        <form asp-action="Login" asp-controller="Account" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div class="mb-3">
                                <label asp-for="Email" class="form-label fw-semibold small"></label>
                                <input asp-for="Email" type="email" class="form-control rounded-3"
                                       placeholder="you@example.com" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="Password" class="form-label fw-semibold small"></label>
                                <input asp-for="Password" type="password" class="form-control rounded-3"
                                       placeholder="••••••••" autocomplete="current-password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold">
                                Sign In
                            </button>
                        </form>

                        <p class="text-center text-muted small mt-4 mb-0">
                            Don't have an account?
                            <a asp-action="Register" asp-controller="Account" class="fw-semibold">Register</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Account Section -->

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

@model RetailsEcosystem.Customer.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="brand-panel-bg min-vh-100 d-flex align-items-stretch">

    <!-- Left branding panel -->
    <div class="d-none d-lg-flex flex-column align-items-center justify-content-center text-white p-5"
         style="width:45%;">
        <div class="text-center">
            <div class="brand-logo-badge rounded-circle d-inline-flex align-items-center justify-content-center mb-4 overflow-hidden">
                <img src="~/images/logo/logo-icon.svg" alt="RetailsEcosystem" style="width:60%;height:60%;" />
            </div>
            <div class="mb-2">
                <img src="~/images/logo/white-logo.svg" alt="RetailsEcosystem" style="height:36px;" />
            </div>
            <p class="mb-5 text-white-50 text-body-sm">Your one-stop shop for everything you need</p>

            <div class="d-flex flex-column gap-3 text-start">
                @foreach (var item in new[] {
                    new { Icon = "lni lni-tag", Label = "Thousands of products, unbeatable prices" },
                    new { Icon = "lni lni-delivery", Label = "Fast & reliable delivery to your door" },
                    new { Icon = "lni lni-shield", Label = "Secure checkout & easy returns" }
                })
                {
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-primary-tint rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                             style="width:38px;height:38px;">
                            <i class="@item.Icon text-primary-brand text-caption"></i>
                        </div>
                        <span class="text-white-50 text-body-sm">@item.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Right form panel -->
    <div class="flex-grow-1 d-flex align-items-center justify-content-center p-4">
        <div style="width:100%;max-width:440px;">

            <!-- Mobile logo -->
            <div class="text-center mb-4 d-lg-none">
                <div class="brand-logo-badge-sm rounded-circle d-inline-flex align-items-center justify-content-center mb-2 overflow-hidden">
                    <img src="~/images/logo/logo-icon.svg" alt="RetailsEcosystem" style="width:60%;height:60%;" />
                </div>
                <div class="fw-bold text-white text-section-title">RetailsEcosystem</div>
            </div>

            <div class="card-panel card border-0 shadow-sm">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4">
                        <h2 class="text-page-title mb-1">Welcome back</h2>
                        <p class="text-muted mb-0 text-body-sm">Sign in to your account to continue shopping.</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger d-flex align-items-start gap-2 rounded-3 py-2 px-3 mb-4" role="alert">
                            <i class="lni lni-warning flex-shrink-0 mt-1 text-caption"></i>
                            <span class="text-body-sm">@Html.ValidationSummary(false)</span>
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div>
                            <label asp-for="Email" class="form-label text-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="lni lni-envelope text-muted"></i>
                                </span>
                                <input asp-for="Email" type="email"
                                       class="form-control form-control-lg border-start-0 bg-light"
                                       placeholder="you@example.com" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger text-caption"></span>
                        </div>

                        <div>
                            <label asp-for="Password" class="form-label text-label"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="lni lni-lock text-muted"></i>
                                </span>
                                <input asp-for="Password" type="password"
                                       class="form-control form-control-lg border-start-0 border-end-0 bg-light"
                                       placeholder="Enter your password" autocomplete="current-password" />
                                <button type="button"
                                        class="input-group-text bg-light border-start-0 password-toggle"
                                        tabindex="-1" aria-label="Toggle password visibility">
                                    <i class="lni lni-eye text-muted opacity-50"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger text-caption"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-semibold">
                            Sign In <i class="lni lni-arrow-right ms-2"></i>
                        </button>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted text-body-sm mb-2">
                            Don't have an account?
                            <a asp-action="Register" asp-controller="Account"
                               class="fw-semibold text-primary-brand">Create one</a>
                        </p>
                        <small class="text-muted text-caption">
                            <i class="lni lni-shield me-1"></i>Secure checkout · RetailsEcosystem
                        </small>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/auth.js" asp-append-version="true"></script>
}

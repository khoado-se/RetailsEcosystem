@model RetailsEcosystem.Customer.Web.Models.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

<div class="brand-panel-bg min-vh-100 d-flex align-items-stretch">
    <!-- Left branding panel -->
    <div class="d-none d-lg-flex flex-column align-items-center justify-content-center text-white p-5"
         style="width:45%;">
        <div class="text-center">
            <div class="brand-logo-badge rounded-circle d-inline-flex align-items-center justify-content-center mb-4 text-white">
                R
            </div>
            <h1 class="fw-bold mb-2">RetailsEcosystem</h1>
            <p class="text-white-50 mb-0">Your one-stop shop for everything you need</p>
        </div>
    </div>

    <!-- Right form panel -->
    <div class="flex-grow-1 d-flex align-items-center justify-content-center p-4">
        <div style="width:100%;max-width:440px;">
            <!-- Mobile logo -->
            <div class="text-center mb-4 d-lg-none">
                <div class="brand-logo-badge rounded-circle d-inline-flex align-items-center justify-content-center mb-2 text-white"
                     style="width:60px;height:60px;font-size:1.5rem;">
                    R
                </div>
                <div class="fw-bold text-white" style="font-size:1.1rem;">RetailsEcosystem</div>
            </div>

            <div class="card border-0 shadow-sm" style="border-radius:var(--radius-xl,16px);">
                <div class="card-body p-4 p-md-5">
                    <h4 class="fw-bold mb-1">Sign In</h4>
                    <p class="text-muted small mb-4">Welcome back! Please enter your details.</p>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger py-2 small">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <form asp-action="Login" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold small"></label>
                            <input asp-for="Email" type="email" class="form-control"
                                   placeholder="you@example.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold small"></label>
                            <input asp-for="Password" type="password" class="form-control"
                                   placeholder="••••••••" autocomplete="current-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                            Sign In
                        </button>
                    </form>

                    <p class="text-center text-muted small mt-4 mb-0">
                        Don't have an account?
                        <a asp-action="Register" asp-controller="Account" class="fw-semibold">Register</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

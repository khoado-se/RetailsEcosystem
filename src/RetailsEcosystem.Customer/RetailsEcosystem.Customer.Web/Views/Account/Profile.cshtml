@model RetailsEcosystem.Customer.Web.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9 col-12">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success d-flex align-items-start gap-2 rounded-3 py-2 px-3 mb-4" role="alert">
                        <i class="lni lni-checkmark-circle flex-shrink-0 mt-1 text-caption"></i>
                        <span class="text-body-sm">@TempData["SuccessMessage"]</span>
                    </div>
                }

                <!-- Profile Card -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h2 class="text-page-title mb-1">My Profile</h2>
                        <p class="text-muted text-body-sm mb-4">Keep your personal information up to date.</p>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger d-flex align-items-start gap-2 rounded-3 py-2 px-3 mb-4" role="alert">
                                <i class="lni lni-warning flex-shrink-0 mt-1 text-caption"></i>
                                <span class="text-body-sm">@Html.ValidationSummary(false)</span>
                            </div>
                        }

                        <form asp-action="Profile" asp-controller="Account" method="post">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label asp-for="FullName" class="form-label text-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="lni lni-user text-muted"></i>
                                    </span>
                                    <input asp-for="FullName" type="text"
                                           class="form-control border-start-0 bg-light" />
                                </div>
                                <span asp-validation-for="FullName" class="text-danger text-caption"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="PhoneNumber" class="form-label text-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="lni lni-phone text-muted"></i>
                                    </span>
                                    <input asp-for="PhoneNumber" type="tel"
                                           class="form-control border-start-0 bg-light"
                                           placeholder="+1 234 567 8900" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger text-caption"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Address" class="form-label text-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="lni lni-map-marker text-muted"></i>
                                    </span>
                                    <input asp-for="Address" type="text"
                                           class="form-control border-start-0 bg-light"
                                           placeholder="123 Main St, City" />
                                </div>
                                <span asp-validation-for="Address" class="text-danger text-caption"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="DateOfBirth" class="form-label text-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="lni lni-calendar text-muted"></i>
                                    </span>
                                    <input asp-for="DateOfBirth" type="date"
                                           class="form-control border-start-0 bg-light" />
                                </div>
                                <span asp-validation-for="DateOfBirth" class="text-danger text-caption"></span>
                            </div>

                            <div class="mb-4">
                                <label asp-for="AvatarUrl" class="form-label text-label"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0">
                                        <i class="lni lni-image text-muted"></i>
                                    </span>
                                    <input asp-for="AvatarUrl" type="url"
                                           class="form-control border-start-0 bg-light"
                                           placeholder="https://example.com/avatar.jpg" />
                                </div>
                                <span asp-validation-for="AvatarUrl" class="text-danger text-caption"></span>
                            </div>

                            <button type="submit" class="btn btn-primary fw-semibold">
                                <i class="lni lni-save me-2"></i>Save Changes
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Change Password Card -->
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">
                        <h3 class="text-section-title mb-3">Change Password</h3>
                        <a asp-action="ChangePassword" asp-controller="Account"
                           class="btn btn-outline-secondary fw-semibold">
                            Change Password
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}

<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Include -->
          <Include>
            [RetailsEcosystem.Customer.Application]*
            ,[RetailsEcosystem.Customer.API]*
          </Include>

          <!-- Exclude assemblies/namespaces -->
          <Exclude>
            [*Tests*]*
            ,[*Infrastructure*]*
            ,[*]Program
            ,[RetailsEcosystem.Customer.API]RetailsEcosystem.Customer.API.Extensions.*
            ,[RetailsEcosystem.Customer.API]RetailsEcosystem.Customer.API.Filters.*
            ,[RetailsEcosystem.Customer.API]RetailsEcosystem.Customer.API.Options.*
            ,[RetailsEcosystem.Customer.API]RetailsEcosystem.Customer.API.Services.*
          </Exclude>

          <!-- Optional: exclude files -->
          <ExcludeByFile>
            **/Migrations/*.cs
            ,**/obj/**/*.cs
            ,**/bin/**/*.cs
          </ExcludeByFile>

          <Format>cobertura</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <!-- Exclude test assemblies, Program entry-point, and Razor compiler-generated view classes -->
          <Exclude>
            [*Tests*]*
            ,[*]Program
            ,[*]*AspNetCoreGeneratedDocument*
          </Exclude>

          <!-- Exclude generated / bootstrap-only files with no testable logic -->
          <ExcludeByFile>
            **/Migrations/*.cs
            ,**/obj/**/*.cs
            ,**/bin/**/*.cs
            ,**/DataSeed/ModelBuilderExtensions.cs
            ,**/DataSeed/IdentitySeed.cs
            ,**/Infrastructure/DependencyInjection.cs
            ,**/Persistences/AppDbContext.cs
          </ExcludeByFile>

          <Format>cobertura</Format>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>

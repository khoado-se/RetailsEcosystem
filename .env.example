# =============================================================================
# RetailsEcosystem — environment variable template
# Copy this file to .env and fill in the values.
# .env is gitignored — never commit it.
# =============================================================================

# --- DockerHub (only needed for docker-compose.pull.yml) ------------------
# Not a secret — this is your public DockerHub username.
DOCKERHUB_USERNAME=your-dockerhub-username

# Image tags — default: latest. Pin to sha-<short> for rollback.
# Example rollback: API_TAG=sha-a1b2c3d docker compose -f docker-compose.pull.yml up -d api
API_TAG=latest
WEB_TAG=latest
ADMIN_TAG=latest

# --- Admin account --------------------------------------------------------
# Seeded on first startup. Only takes effect on a fresh database.
ADMIN_EMAIL=admin@retailsecosystem.com
ADMIN_PASSWORD=Admin@123456

# --- SQL Server -----------------------------------------------------------
# Minimum requirements: 8 chars, uppercase, lowercase, digit, special char.
SA_PASSWORD=Change_Me_Strong123!

# Optional: database name (default: RetailsEcosystemDb)
# DB_NAME=RetailsEcosystemDb

# --- JWT ------------------------------------------------------------------
# Must be at least 32 characters. Change before deploying.
JWT_SECRET_KEY=RetailsEcosystem-Change-This-Secret-Key-Min32Chars!!

# Optional: token expiry overrides
# JWT_ACCESS_EXPIRY_MINUTES=15
# JWT_REFRESH_EXPIRY_DAYS=7

# --- Cloudinary (optional) ------------------------------------------------
# Leave empty to disable file uploads. File upload endpoints will return 500
# if these are empty and an upload is attempted.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=test

# --- VNPay (optional) -----------------------------------------------------
# Leave empty if not using VNPay payment integration.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:8081/vnpay/return

# --- CORS -----------------------------------------------------------------
# Origins allowed to call the API. Must match the browser origin exactly.
ALLOWED_ORIGIN_ADMIN=http://localhost:3000
ALLOWED_ORIGIN_WEB=http://localhost:8081

# --- Admin SPA build args -------------------------------------------------
# Baked into the React bundle at build time. Change requires image rebuild.
VITE_HOST_URL=http://localhost:8080/api
VITE_PRODUCT_PLACEHOLDER_IMAGE=http://localhost:8080/images/products/product-placeholder-image.jpg
